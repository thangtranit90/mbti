# Local dev secrets for `apps/api` (Cloudflare Worker).
# Wrangler reads this file automatically when you run `pnpm dev` (which runs
# `wrangler dev --local`). Copy this file to `.dev.vars` and replace the
# placeholders with real values from the team secrets vault.
#
# DO NOT commit `.dev.vars` — it is gitignored at the repo root.
# Production secrets are set via `wrangler secret put <NAME>` — see Story 1.6
# Operational Runbook.
#
# ONLY worker secrets — never `DB`/`KV`/`ASSETS_BUCKET`/`RATE_LIMITER` (those
# are bindings declared in `wrangler.toml`, not env values).
#
# Do NOT wrap values in quotes. Wrangler's dotenv parser treats values as
# literal strings; some Wrangler versions keep outer quotes verbatim, which
# silently breaks HMAC comparisons (e.g., Stripe webhook signature).

# Anthropic API (FR7–FR10 AI insight generation; NFR17 fallback to D1 curated)
ANTHROPIC_API_KEY=REPLACE_ME_ANTHROPIC_KEY

# PayOS — Vietnam payment provider (FR25–FR29; NFR19)
PAYOS_API_KEY=REPLACE_ME_PAYOS_KEY

# Stripe — international card payments (FR25–FR29; NFR19)
STRIPE_SECRET_KEY=REPLACE_ME_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME_STRIPE_WEBHOOK_SECRET

# Admin auth — bcrypt hash of admin password (FR33; architecture.md auth model)
# Generate without leaking the password to shell history:
#   read -srp "Admin password: " ADMIN_PW; echo
#   ADMIN_PW="$ADMIN_PW" node -e 'import("bcryptjs").then(m => m.hash(process.env.ADMIN_PW, 12).then(console.log))'
#   unset ADMIN_PW
# The placeholder below is a well-formed `$2b$12$` shape so `bcryptjs.compare`
# returns `false` deterministically rather than throwing on malformed input.
ADMIN_PASSWORD_HASH=$2b$12$REPLACE.WITH.REAL.BCRYPT.HASH........................
